<UserControl x:Class="DiskMonitor.SystemDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">
    <Grid Margin="12,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="SummaryText" Text="System（PID 4）"
                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TabControl Grid.Row="1" x:Name="Tabs"
                    Background="{DynamicResource ControlBackground}"
                    Foreground="{DynamicResource AppForeground}"
                    BorderBrush="{DynamicResource BorderColor}">
            <!-- 按文件 -->
            <TabItem x:Name="FilesTab" Header="按文件">
                <Grid Margin="4,8,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="230"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <oxy:PlotView x:Name="ReadPieView" Background="{DynamicResource AppBackground}"/>
                        <oxy:PlotView x:Name="WritePieView" Grid.Column="1" Margin="6,0,0,0"
                                      Background="{DynamicResource AppBackground}"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="FileList" Margin="0,8,0,0" BorderThickness="1"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              RowStyle="{StaticResource PieRowStyle}" CellStyle="{StaticResource PieCellStyle}"
                              Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource ControlForeground}"
                              BorderBrush="{DynamicResource BorderColor}"
                              HorizontalGridLinesBrush="{DynamicResource BorderColor}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="文件" Width="2.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="4,0" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="读取" Width="0.9*" Binding="{Binding ReadText}"/>
                            <DataGridTextColumn Header="写入" Width="0.9*" Binding="{Binding WriteText}"/>
                            <DataGridTextColumn Header="读占比" Width="0.8*" Binding="{Binding ReadPercentText}"/>
                            <DataGridTextColumn Header="写占比" Width="0.8*" Binding="{Binding WritePercentText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 按磁盘 -->
            <TabItem x:Name="DisksTab" Header="按磁盘">
                <DataGrid x:Name="DiskList" Margin="4,8,4,4" BorderThickness="1"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource ControlForeground}"
                          BorderBrush="{DynamicResource BorderColor}"
                          HorizontalGridLinesBrush="{DynamicResource BorderColor}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="磁盘" Width="1.2*" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="卷" Width="1.2*" Binding="{Binding Volumes}"/>
                        <DataGridTextColumn Header="读取" Width="1*" Binding="{Binding ReadText}"/>
                        <DataGridTextColumn Header="写入" Width="1*" Binding="{Binding WriteText}"/>
                        <DataGridTextColumn Header="读占比" Width="0.8*" Binding="{Binding ReadPercentText}"/>
                        <DataGridTextColumn Header="写占比" Width="0.8*" Binding="{Binding WritePercentText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="HintText" Margin="2,8,0,0" FontSize="11" Opacity="0.75"
                   TextWrapping="Wrap"
                   Text="每秒刷新。文件名来自 ETW DiskFileIO 映射，未解析的 I/O 单列显示。"/>
    </Grid>
</UserControl>
